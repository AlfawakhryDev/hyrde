# Copy to .env.local and fill in. Never commit real values: .env* is ignored,
# and GitHub push protection rejects known secret formats.
#
# Ask the team lead for DEVELOPMENT values. Never use production keys locally.
# Production values live in Vercel (and one in Supabase Vault, noted below).

# ── Required ──────────────────────────────────────────────────────────────
# Supabase. The anon key is public by design; row-level security enforces access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses EVERY RLS policy: never prefix it with NEXT_PUBLIC_.
# Needed for pilot support sessions and their audit log.
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic. Every AI route (scoping, matching, vetting, reports).
ANTHROPIC_API_KEY=

# ── Email (SendGrid) ─────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM=notifications@hyrde.net
SENDGRID_FROM_NAME=Hyrde
SENDGRID_REPLY_TO=
# Where admin copies of notifications go.
NOTIFY_ADMIN_EMAIL=
# Shared secret the database uses to call /api/notify/dispatch. Must equal the
# Supabase Vault secret `notify_webhook_secret`, or every email stops.
NOTIFY_SECRET=

# ── Voice interviews (optional; falls back to the browser's own voice) ────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
OPENAI_API_KEY=
OPENAI_TTS_VOICE=

# ── Abuse protection and kill switches ───────────────────────────────────
# false = every AI route refuses (stops Anthropic spend).
AI_ENABLED=true
# Requests per minute: per IP, and per server instance.
AI_RATE_LIMIT=30
AI_GLOBAL_LIMIT=80
TURNSTILE_SECRET_KEY=
LEADS_ADMIN_KEY=
CRON_SECRET=

# ── Pilot controls ───────────────────────────────────────────────────────
# false = support sessions are refused for everyone. Set when the pilot ends.
IMPERSONATION_ENABLED=true
# The one specialist every client is matched to during the pilot.
PILOT_SPECIALIST_ID=

# ── SEO ownership verification ───────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
