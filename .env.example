# ── Required ──────────────────────────────────────────────────────────────
# Supabase project (anon key is public by design; RLS enforces access)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Anthropic Claude — used by every AI route (matching, scoping, review, vetting)
ANTHROPIC_API_KEY=sk-ant-your-key

# ── Optional: voice interview (falls back to browser speech if unset) ─────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
OPENAI_API_KEY=
OPENAI_TTS_VOICE=

# ── Optional: abuse protection / kill switches ────────────────────────────
AI_ENABLED=true
AI_RATE_LIMIT=8
AI_GLOBAL_LIMIT=80
TURNSTILE_SECRET_KEY=
LEADS_ADMIN_KEY=

# ── Optional: SEO ownership verification ──────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Note: Resend (match-notification emails) is configured server-side in the
# Supabase Vault as `resend_api_key`, not here.
